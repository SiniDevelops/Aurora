# ─────────────────────────────────────────────────
# Aurora — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# LLM Provider API Keys (set the ones you plan to use)
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Ollama (local, no key needed — just URL)
OLLAMA_BASE_URL=http://localhost:11434

# Vault Path (absolute path to your Obsidian vault)
AURORA_VAULT_PATH=~/Documents/MyVault

# Optional: PIN lock (leave empty to disable)
AURORA_PIN=

# Optional: Debug mode
AURORA_DEBUG=false
